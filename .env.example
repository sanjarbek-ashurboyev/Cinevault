# ── Django core ────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=cinevault.example.com,www.cinevault.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cinevault.example.com,https://www.cinevault.example.com
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

# ── database ───────────────────────────────────────────────────
DB_ENGINE=postgres
POSTGRES_DB=cinevault
POSTGRES_USER=cinevault
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379


# ── email ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tickets@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=CineVault <tickets@example.com>


# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
